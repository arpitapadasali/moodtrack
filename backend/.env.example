# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Format: mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/moodtrack_db?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/moodtrack_db
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/moodtrack_db?retryWrites=true&w=majority
MONGODB_DB_NAME=moodtrack_db

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_in_production
JWT_EXPIRES_IN=7d

# Scheduled Reminders (node-cron)
REMINDERS_ENABLED=true
REMINDER_CRON_SCHEDULE="* * * * *"

# Machine Learning Insights Microservice (FastAPI / Python)
ML_SERVICE_URL=http://127.0.0.1:8000

# Weather API (Optional - OpenWeatherMap API key)
# If left empty, the application automatically falls back to Open-Meteo free geocoding and weather API.
WEATHER_API_KEY=""

# Security & Rate Limiting
SALT_ROUNDS=12
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=15
