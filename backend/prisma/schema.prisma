// MoodTrack Prisma Schema
// PostgreSQL database layer for MoodTrack

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  moodEntries  MoodEntry[]
  reminders    Reminder[]

  @@map("users")
}

model MoodEntry {
  id          String   @id @default(uuid())
  userId      String
  mood        Int      // Integer mood score (e.g., 1 to 5 or 1 to 10)
  feelings    String[] @default([]) // Array of emotional state tags (PostgreSQL native text array)
  reflection  String?  @db.Text     // Detailed daily reflection/notes
  sleepHours       Float                 // Sleep duration in hours (e.g. 7.5)
  entryDate        DateTime @db.Date     // Calendar entry date without time distortion (YYYY-MM-DD)
  // Optional weather metrics for statistical correlation
  temperature      Float?                // Ambient temperature in Celsius
  weatherCondition String?               // Standardized weather condition (e.g. "Clear", "Clouds", "Rain")
  precipitation    Float?                // Precipitation in mm
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  // Constraint: One mood entry per user per entryDate
  @@unique([userId, entryDate])
  // Indexes for time-series query optimization across months and years
  @@index([userId])
  @@index([entryDate])
  @@index([userId, entryDate])

  @@map("mood_entries")
}

model Reminder {
  id           String   @id @default(uuid())
  userId       String
  enabled      Boolean  @default(true)
  reminderTime String   // Scheduled reminder time in 24h format (e.g. "20:00")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])

  @@map("reminders")
}
